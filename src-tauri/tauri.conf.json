{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noctua",
  "version": "0.1.0",
  "identifier": "org.noctua.ebookreader",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Noctua - Ebook Reader",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline' blob:",
        "img-src": "'self' blob: data:",
        "font-src": "'self' blob: data:",
        "media-src": "'self' blob:",
        "frame-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost blob: data: ws://localhost:1420"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (C) 2026 probuho y colaboradores de Noctua"
  }
}